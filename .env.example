# ==============================================================================
# Intelligent Student Retention & Academic Risk Management System
# Environment Configuration
# ==============================================================================

# Database Connection URL:
# 1. Cloud PostgreSQL (Neon / Supabase / AWS RDS):
#    DATABASE_URL=postgresql://user:password@ep-sample-project.neon.tech/retention_db?sslmode=require
#
# 2. Local PostgreSQL:
#    DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retention_db
#
# 3. Local SQLite (Default fallback if left blank or omitted):
#    DATABASE_URL=sqlite:///./retention_system.db

DATABASE_URL=sqlite:///./retention_system.db

# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=True

# Secret key for session security (generate a secure string for production)
SECRET_KEY=university-super-secret-risk-key-change-in-production

